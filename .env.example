# Backend HTTP server
SERVER_PORT=8080

# PostgreSQL: create the database and configure credentials before starting.
DB_URL=jdbc:postgresql://localhost:5432/aitu-awards
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-database-password

# Microsoft Entra ID: use the values from your Web app registration.
MICROSOFT_TENANT_ID=your-directory-tenant-id
MICROSOFT_CLIENT_ID=your-application-client-id
# Use the client secret VALUE, not the secret ID.
MICROSOFT_CLIENT_SECRET=your-client-secret-value

